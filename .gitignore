# --- Dependencies ---
node_modules/
client/node_modules/
server/node_modules/

# --- Environment variables (never commit real secrets) ---
.env
.env.local
.env.*.local
server/.env
client/.env

# --- Build output ---
client/build/
build/
dist/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test coverage ---
coverage/

# --- Database backups (generated by scripts/backup-db.sh) ---
backups/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor/IDE ---
.vscode/
.idea/
*.swp

# --- Misc ---
*.pid
*.seed
*.pid.lock
.eslintcache
